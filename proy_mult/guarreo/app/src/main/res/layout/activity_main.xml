<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">


    <!-- === EJERCICIO DIAPO  -->
    <!-- FILA DE ARRIBA -->
    <View
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="start"
        android:background="#000DFF" />

    <View
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="top|center"
        android:background="#7980FF" />

    <View
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="end"
        android:background="#CFD2FF" />

    <!-- FILA DEL MEDIO -->
    <View
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="start|center"
        android:background="#6AFF00" />

    <View
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="center"
        android:background="#A8FF6B" />

    <View
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="end|center"
        android:background="#CFFFAC" />

    <!-- FILA DE ABAJO -->
    <View
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="start|bottom"
        android:background="#FF002F" />

    <View
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="bottom|center"
        android:background="#FF6783" />

    <View
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_gravity="end|bottom"
        android:background="#FFBECA" />
</FrameLayout>